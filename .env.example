# .env.example: copie para .env e troque a senha.
# O mesmo arquivo serve à aplicação (uv run --env-file .env) e ao Docker Compose.
# Escolha um dos modos abaixo.

# --- Docker Compose ou PostgreSQL local ------------------------------------
# Com Docker, o Compose cria o usuário e o banco com estes valores. O contêiner
# da aplicação troca PGHOST por "db" sozinho (veja compose.yaml).
PGHOST=localhost
PGPORT=5432
PGDATABASE=empresa
PGUSER=empresa_app
PGPASSWORD=troque-esta-senha

# --- Nuvem (Neon, Supabase, RDS etc.) ---------------------------------------
# Copie host, banco, usuário e senha do painel do provedor, use a conexão
# direta e exija TLS:
# PGHOST=ep-exemplo-123456.sa-east-1.aws.neon.tech
# PGPORT=5432
# PGDATABASE=empresa
# PGUSER=empresa_app
# PGPASSWORD=senha-do-provedor
# PGSSLMODE=require
# POOL_MAX=3                 # planos gratuitos limitam conexões
# PREPARE_THRESHOLD=off      # só se usar um pooler em modo transação
